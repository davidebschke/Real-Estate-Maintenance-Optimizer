# Production database connection (Supabase project "RemoDB"), set as environment variables of the backend process.
# Locally these can stay unset: application.yml defaults to the docker-compose.yml database.
# Use the Supabase "Session pooler" connection (IPv4-reachable, port 5432), not the direct (IPv6-only) or transaction pooler (port 6543) one.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database-password>
