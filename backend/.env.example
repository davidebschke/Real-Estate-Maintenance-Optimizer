# Production database connection (Supabase project "RemoDB"), set as environment variables of the backend process.
# Locally these can stay unset: application.yml defaults to the docker-compose.yml database.
# Use the Supabase "Session pooler" connection (IPv4-reachable, port 5432), not the direct (IPv6-only) or transaction pooler (port 6543) one.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database-password>

# Authentication (required everywhere). Locally, copy these lines into backend/.env (git-ignored, read on startup
# via spring.config.import); in production they are real environment variables written by the deploy workflow.
# HMAC key for the session JWT, at least 32 bytes, e.g. generated with: openssl rand -base64 48
REMO_AUTH_JWT_SECRET=<random-secret-of-at-least-32-bytes>
# Initial password of the "account_default" account (8 characters up to 72 bytes). Only applied while that account has no password yet;
# after the first start it is stored as a BCrypt hash and changing this value has no effect anymore.
REMO_AUTH_INITIAL_USER_PASSWORD=<initial-password>
# Local development runs on plain http://localhost; production over HTTPS must keep the default (true).
REMO_AUTH_COOKIE_SECURE=false

# Road routing via openrouteservice (optional). Without it the map keeps drawing straight lines. Create a free key at https://openrouteservice.org/dev/#/signup;
# the free plan allows 2,000 directions requests per day and 40 per minute. Locally put both lines into backend/.env; in production they come from the deploy workflow
# (GitHub secret REMO_ROUTING_API_KEY; routing is enabled automatically while that secret is set).
REMO_ROUTING_ENABLED=true
REMO_ROUTING_API_KEY=<openrouteservice-api-key>

# AI appointment optimization via Claude (optional). Without it the optimization page explains that the feature is off. Create a key at
# https://console.anthropic.com/; it also needs road routing (see above) for the travel matrix. Locally put the lines into backend/.env; in production
# they come from the deploy workflow (GitHub secret REMO_AI_API_KEY). REMO_AI_MODEL is optional and defaults to claude-haiku-4-5.
REMO_AI_ENABLED=true
REMO_AI_API_KEY=<anthropic-api-key>
